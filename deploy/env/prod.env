# 给 MySQL 容器
MYSQL_DATABASE=company_site_prod
MYSQL_USER=app
MYSQL_PASSWORD=app_pass
MYSQL_ROOT_PASSWORD=root_pass_prod

# 给后端容器（最终值，代码直接读它）
DATABASE_URL=mysql+pymysql://app:app_pass@db:3306/company_site_prod

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173