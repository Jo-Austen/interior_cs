# ---------- MySQL (used by db container) ----------
MYSQL_DATABASE=interior_test
MYSQL_USER=interior
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ---------- Backend (used by backend + migrate container) ----------
DATABASE_URL=mysql+pymysql://interior:change_me@db:3306/interior_test

# 前端访问后端：本地用端口方式
NUXT_PUBLIC_API_BASE=http://localhost:8081

# CORS：允许 test 前端来源
CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Backend listen port (container internal)
BACKEND_PORT=8000


# ===============================
# Frontend (Nuxt 3 - test)
# ===============================
# Frontend talks to backend via exposed test port
NUXT_PUBLIC_API_BASE=http://localhost:8081

# ===============================
# Mail (disabled in test)
# ===============================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_TLS=false
SMTP_SSL=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Interior Co.

# 公司信息（给预约方的邮件里使用）
COMPANY_NAME=Interior Co.
COMPANY_ADDR=〒807-0834 福岡県北九州市八幡西区北鷹見町10-15
COMPANY_PHONE=093-123-4567
COMPANY_EMAIL=info@example.com
COMPANY_SITE=https://www.example.com

# 预约通知收件人（公司侧）
APPOINTMENT_NOTIFY_TO=ops@example.com,sales@example.com

