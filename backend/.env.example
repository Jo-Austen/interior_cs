# ========================
# Backend Environment Example
# ========================

# Database
DATABASE_URL=

# 允许跨域的前端源
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ========================
# SMTP 基础（任选其一：企业邮箱 / SendGrid / Mailgun / 本地 MailHog）
# ========================

# MailHog 本地调试：
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_TLS=false
SMTP_SSL=false

# 生产环境改用真实 SMTP：
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=yourname@outlook.com
# SMTP_PASS=your_app_password
# SMTP_TLS=true
# SMTP_SSL=false

# 发件人信息
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Interior Co.

# ========================
# 公司信息（用于发给客户的确认邮件）
# ========================
COMPANY_NAME=Interior Co.
COMPANY_ADDR=〒807-0834 福岡県北九州市八幡西区北鷹見町10-15
COMPANY_PHONE=093-123-4567
COMPANY_EMAIL=info@example.com
COMPANY_SITE=https://www.example.com

# ========================
# 公司侧通知收件人（多邮箱用逗号隔开）
# ========================
APPOINTMENT_NOTIFY_TO=ops@example.com,sales@example.com
